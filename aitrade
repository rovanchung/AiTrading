def cmd_db(args):
    """Query the SQLite database."""
    if not ACTIVE_VERSION:
        print(f"  {YELLOW}No version selected. Pass --version v3 or --version v4.{RESET}")
        return
    db_path = _version_db_path()
    if not db_path or not os.path.isfile(db_path):
        print(f"  Database not found at {db_path}")
        print(f"  Run: ./aitrade setup-db")
        return

    query_name = args[0] if args else "help"
    queries = {
        "positions": (
            "Open Positions",
            """SELECT ticker, qty, entry_price, stop_loss, take_profit, entry_time
               FROM positions WHERE status='open' ORDER BY entry_time DESC""",
        ),
        "closed": (
            "Closed Trades",
            """SELECT ticker, qty, entry_price, exit_price, pnl,
                      ROUND((exit_price - entry_price) / entry_price * 100, 1) AS pnl_pct,
                      exit_reason, exit_time
               FROM positions WHERE status='closed' ORDER BY exit_time DESC LIMIT 20""",
        ),
        "orders": (
            "Recent Orders",
            """SELECT ticker, side, qty, status, filled_price, submitted_at
               FROM orders ORDER BY submitted_at DESC LIMIT 20""",
        ),
        "portfolio": (
            "Portfolio History",
            """SELECT snapshot_time, total_value, cash, positions_value, peak_value
               FROM portfolio_snapshots ORDER BY snapshot_time DESC LIMIT 10""",
        ),
    }

    if query_name not in queries:
        print(f"  Unknown query: {query_name}")
        print(f"  Options: {', '.join(queries.keys())}")
        return

    title, sql = queries[query_name]
    conn = sqlite3.connect(db_path)
    conn.execute("PRAGMA query_only = ON")
    cur = conn.execute(sql)
    cols = [d[0] for d in cur.description]
    rows = cur.fetchall()
    conn.close()

    if not rows:
        print(f"\n  {title}: (no data)")
        return

    # Format as table
    widths = [len(c) for c in cols]
    for row in rows:
        for i, val in enumerate(row):
            widths[i] = max(widths[i], len(str(val) if val is not None else ""))

    header = "  ".join(f"{c:<{widths[i]}}" for i, c in enumerate(cols))
    sep = "  ".join("-" * widths[i] for i in range(len(cols)))
    print(f"\n  {BOLD}{title}{RESET}\n")
    print(f"  {header}")
    print(f"  {sep}")
    for row in rows:
        line = "  ".join(
            f"{(str(v) if v is not None else ''):<{widths[i]}}"
            for i, v in enumerate(row)
        )
        print(f"  {line}")
    print()


def _load_config():
    import yaml
    with open(os.path.join(PROJECT_ROOT, "config.yaml")) as f:
        return yaml.safe_load(f)


def _strategy_table_lines(active_version=None):
    """Build the V3/V4 strategy comparison table as a list of printable lines."""
    try:
        cfg = _load_config()
    except Exception as e:
        return [f"  Failed to load config.yaml: {e}"]

    trading = cfg.get("trading", {})
    accounts = cfg.get("accounts", {})

    versions = ("v3", "v4")
    eff = {v: {**trading, **accounts.get(v, {})} for v in versions}

    def neg_pct(val):
        if val is None:
            return None
        return "0" if val == 0 else f"-{val*100:.4g}%"

    def pos_pct(val):
        if val is None:
            return None
        return "0" if val == 0 else f"+{val*100:.4g}%"

    def cell(v, key, *, formatter=pos_pct):
        p = eff[v]
        if key not in p:
            return "—"
        out = formatter(p.get(key))
        return "—" if out is None else out

    rows = [
        ("v2_profit_take_pct",                 [cell(v, "v2_profit_take_pct") for v in versions]),
        ("v2_loss_cut_pct",                    [cell(v, "v2_loss_cut_pct",                  formatter=neg_pct) for v in versions]),
        ("v2_profit_take_vs_prior_close_pct",  [cell(v, "v2_profit_take_vs_prior_close_pct") for v in versions]),
        ("v2_loss_cut_vs_prior_close_pct",     [cell(v, "v2_loss_cut_vs_prior_close_pct",   formatter=neg_pct) for v in versions]),
        ("v2_min_hold_minutes",                [cell(v, "v2_min_hold_minutes",              formatter=lambda x: f"{x}m") for v in versions]),
        ("v2_sell_threshold",                  [cell(v, "v2_sell_threshold",                formatter=str) for v in versions]),
        ("v2_rebalance_min_share_diff",        [cell(v, "v2_rebalance_min_share_diff",      formatter=str) for v in versions]),
        ("buy_threshold",                      [str(eff[v].get("buy_threshold", "—"))      for v in versions]),
    ]

    label_w = max(len(r[0]) for r in rows)
    col_w = max(len(v.upper()) for v in versions)
    for _, cells in rows:
        col_w = max(col_w, *(len(c) for c in cells))

    lines = []
    header = f"  {'param':<{label_w}}  " + "  ".join(f"{v.upper():<{col_w}}" for v in versions)
    lines.append(f"  {BOLD}{header.strip()}{RESET}")
    lines.append(f"  {'-' * label_w}  " + "  ".join("-" * col_w for _ in versions))
    for name, cells in rows:
        formatted = []
        for i, c in enumerate(cells):
            text = f"{c:<{col_w}}"
            if active_version == versions[i]:
                text = f"{YELLOW}{text}{RESET}"
            formatted.append(text)
        lines.append(f"  {name:<{label_w}}  " + "  ".join(formatted))
    return lines


def cmd_info(_args):
    """Show reference guide + effective configuration for all versions."""
    try:
        cfg = _load_config()
    except Exception as e:
        print(f"  Failed to load config.yaml: {e}")
