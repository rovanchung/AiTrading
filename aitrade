#!/usr/bin/env python3
"""AiTrading — Interactive CLI and command dispatcher.

Interactive:
    ./aitrade                     # Launch interactive menu

Commands:
    ./aitrade run [--no-macro]    # Start continuous trading scheduler
    ./aitrade once [--no-macro]   # Run one full cycle and exit
    ./aitrade dry-run [--no-macro]# Scan and analyze only, no trades
    ./aitrade dashboard [--port N] [--debug]  # Launch web dashboard (--debug: auto-restart on .py edits)
    ./aitrade scan                # Show candidates that pass filters
    ./aitrade scan --analyze      # Full scoring analysis
    ./aitrade scan --tickers X Y  # Analyze specific tickers
    ./aitrade scan --top N        # Show top N results
    ./aitrade setup-db            # Initialize the database (non-destructive)
    ./aitrade reset-db            # Delete + re-init DB for active --version
    ./aitrade reset-db --all      # Delete + re-init all per-version DBs
    ./aitrade reset-db --yes      # Skip confirmation prompt
    ./aitrade sync                # Reconcile local DB with Alpaca (positions + cash)
    ./aitrade install             # Install dependencies
    ./aitrade logs [main|txn|alerts]  # View logs
    ./aitrade db [positions|closed|orders|portfolio]  # Query database
    ./aitrade info                # Show detailed reference guide

Account selection:
    ./aitrade --version v4 run                          # v4 strategy, credentials via .env mapping
    ./aitrade --version v4 --account MAIN run &         # v4 strategy vs. MAIN account
    ./aitrade --version v4 --account WIFE run &         # v4 strategy vs. WIFE account, concurrent
    # Each gets its own DB: data/trading_v4_main.db, data/trading_v4_wife.db
"""

