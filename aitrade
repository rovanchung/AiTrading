def _version_db_path():
    """Return the DB path for the active (version, account) combo, or None
    if no version is selected (there is no default database)."""
    if ACTIVE_VERSION and ACTIVE_ACCOUNT:
        return os.path.join(
            PROJECT_ROOT, "data",
            f"trading_{ACTIVE_VERSION}_{ACTIVE_ACCOUNT.lower()}.db",
        )
    if ACTIVE_VERSION:
        import yaml
        with open(os.path.join(PROJECT_ROOT, "config.yaml")) as f:
            cfg = yaml.safe_load(f)
        accounts = cfg.get("accounts", {})
        acct = accounts.get(ACTIVE_VERSION, {})
        rel = acct.get("database_path")
        if rel:
            return os.path.join(PROJECT_ROOT, rel)
    return None

