def cmd_reset_db(args):
    """Delete and re-initialize the local database for one version (or all).

    Usage:
        ./aitrade --version v3 reset-db    # reset v3
        ./aitrade reset-db --all           # reset v3, v4
        ./aitrade reset-db --yes           # skip confirmation
    """
    skip_confirm = "--yes" in args or "-y" in args
    reset_all = "--all" in args

    if reset_all:
        target_label = "ALL per-version databases (v3, v4)"
    elif ACTIVE_VERSION:
        target_label = f"{ACTIVE_VERSION.upper()} database"
    else:
        print(f"  {YELLOW}No version selected. Pass --version vN, or use --all.{RESET}")
        return

    print(f"\n  {BOLD}This will delete and recreate:{RESET} {target_label}")

    if not skip_confirm:
        if not pick_yes_no("This permanently deletes local trade history. Continue?"):
            print("  Cancelled.")
            return

    cmd = [PYTHON, os.path.join(PROJECT_ROOT, "setup_db.py")]
    if reset_all:
        cmd.append("--reset-all")
    else:
        cmd += ["--reset"] + _version_args()
    subprocess.run(cmd)

    print(f"\n  {GREEN}Reset complete.{RESET}")


